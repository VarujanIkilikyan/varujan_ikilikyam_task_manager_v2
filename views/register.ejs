<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Форма регистрации</title>
    <link rel="stylesheet" href="/css/registerStyles.css">
</head>
<body>
<div class="form-container">
    <h2>Регистрация</h2>

    <!-- Сообщение об успехе -->
    <div class="success-message" id="successMessage">✅ Регистрация успешна!</div>

    <form id="registrationForm">
        <!-- Имя -->
        <div class="form-group">
            <label for="name">Имя</label>
            <input type="text" id="name" name="username" placeholder="Введите ваше имя"  />
            <span class="error-message" data-error="username"></span>
        </div>

        <!-- Email -->
        <div class="form-group">
            <label for="email">Email</label>
            <input type="text" id="email" name="email" placeholder="Введите email"  />
            <span class="error-message" data-error="email"></span>
        </div>

        <!-- Пароль -->
        <div class="form-group">
            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" placeholder="Введите пароль"  minlength="6" />
            <span class="error-message" data-error="password"></span>
        </div>

        <!-- Возраст -->
        <div class="form-group">
            <label for="age">Возраст</label>
            <input type="number" id="age" name="age" placeholder="Введите возраст" min="1" max="120"  />
            <span class="error-message" data-error="age"></span>
        </div>

        <button type="submit" id="submitBtn">Зарегистрироваться</button>
        <a href="login">loigin</a>
    </form>
</div>

<script src = "/javascript/registration.js">
</script>
</body>
</html>