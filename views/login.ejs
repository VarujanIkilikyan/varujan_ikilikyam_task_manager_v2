<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Вход</title>
    <link rel="stylesheet" href="/css/loginStyles.css">

</head>
<body>
<div class="form-container">
    <h2>Вход</h2>

    <!-- Сообщение об успехе -->
    <div class="success-message" id="successMessage">✅ Успешный вход!</div>

    <form id="loginForm">
        <!-- Email -->
        <div class="form-group">
            <label for="email">Email</label>
            <input type="text" id="email" name="email" placeholder="Введите email"  />
            <span class="error-message" data-error="email"></span>
        </div>

        <!-- Пароль -->
        <div class="form-group">
            <label for="password">Пароль</label>
            <input type="password" id="password" name="password" placeholder="Введите пароль" />
            <span class="error-message" data-error="password" ></span>
        </div>

        <button type="submit" id="submitBtn">Войти</button>
    </form>
</div>

<script src = "/javascript/login.js">
</script>
</body>
</html>